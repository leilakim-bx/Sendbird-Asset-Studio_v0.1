# Copy this file to .env.local and fill in the values.

# Pexels API — free at https://www.pexels.com/api/
PEXELS_API_KEY=your_pexels_api_key_here

# Site password gate (proxy.ts). Leave unset to disable the login gate locally.
SITE_PASSWORD=your_site_password_here

# Vercel Blob — created automatically when a Blob Store is connected to the project.
# Optional locally; run `vercel env pull` after connecting Storage to test cloud backups.
BLOB_READ_WRITE_TOKEN=your_vercel_blob_read_write_token_here
