# Copy this file to .env.local and fill in the values.

# Pexels API — free at https://www.pexels.com/api/
PEXELS_API_KEY=your_pexels_api_key_here

# Anthropic API — https://console.anthropic.com
# Set to "mock" to test the scenario generator without a real key.
ANTHROPIC_API_KEY=mock

# Site password gate (proxy.ts). Leave unset to disable the login gate locally.
SITE_PASSWORD=your_site_password_here
